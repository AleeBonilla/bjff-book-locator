{
  "name": "@bjff/api",
  "version": "0.1.0",
  "private": true,
  "description": "API administrativa del localizador de libros de la BJFF",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file=../../.env ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js --database-url-var MIGRATION_DATABASE_URL --ignore-pattern README.md -m ../../database/migrations up",
    "migrate:test": "node --env-file=../../.env ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js --database-url-var TEST_DATABASE_URL --ignore-pattern README.md -m ../../database/migrations up",
    "seed:admin": "tsx scripts/seed-admin.ts"
  },
  "dependencies": {
    "@bjff/api-types": "*",
    "@bjff/classification": "*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^5.6.0",
    "kysely": "^0.27.5",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "node-pg-migrate": "^7.9.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "unplugin-swc": "^1.5.1"
  }
}
