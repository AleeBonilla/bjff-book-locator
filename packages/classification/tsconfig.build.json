{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // CommonJS para que la API, compilada a CommonJS, pueda cargarlo sin interoperación.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
