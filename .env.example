# Copiar a .env y ajustar. `.env` no se versiona (principio VI de la constitución).

# --- Base de datos ---
# El usuario de la aplicación debe tener privilegios mínimos: solo DML sobre las
# tablas que usa la funcionalidad. No debe ser el propietario del esquema.
DATABASE_URL=postgres://bjff_app:cambiar@localhost:5432/bjff

# Base separada para las pruebas. Las pruebas vacían tablas antes de cada caso, así
# que nunca deben apuntar a la base de desarrollo.
TEST_DATABASE_URL=postgres://bjff:cambiar@localhost:5432/bjff_test

# Credenciales del contenedor de desarrollo (docker-compose.yml)
POSTGRES_DB=bjff
POSTGRES_USER=bjff
POSTGRES_PASSWORD=cambiar

# --- API ---
API_PORT=3000
# Origen permitido para el frontend
WEB_ORIGIN=http://localhost:5173
# Poner true al servir por HTTPS: marca la cookie de sesión como Secure
COOKIE_SECURE=false
# Duración de la sesión inactiva, en minutos
SESSION_TTL_MINUTES=480

# --- Límites del archivo de importación (FR-013a) ---
# Holgados respecto del volumen previsto en SC-006 (10 000 filas, ~2,5 MB)
IMPORT_MAX_FILE_BYTES=52428800
IMPORT_MAX_ROWS=200000

# --- Aprovisionamiento de la cuenta ADMIN (apps/api/scripts/seed-admin.ts) ---
# Solo se leen al ejecutar el script. Nunca se registran en la salida.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=
