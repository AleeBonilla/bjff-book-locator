POSTGRES_CONTAINER_NAME=bjff-book-locator-postgres
POSTGRES_DB=bjff_book_locator
POSTGRES_USER=bjff
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
API_PORT=3000
DATABASE_URL=postgresql://bjff:replace-with-local-password@localhost:5432/bjff_book_locator
ADMIN_ACTOR_USERNAME=system-v1
ALLOW_UNAUTHENTICATED_ADMIN=true
SVG_STORAGE_DIR=./var/maps
MAX_SVG_UPLOAD_BYTES=10485760
